# Copy to .env.local for local development. On Vercel, add the same keys under
# Settings → Environment Variables (Production).

# TiDB Cloud Starter → Connect → "General" connection string, database `wedora`.
# TLS is switched on automatically for *.tidbcloud.com hosts.
DATABASE_URL=mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/wedora
# Local MySQL instead:  mysql://root:password@localhost:3306/wedora

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Your production URL. Optional on Vercel (it falls back to the production domain).
BETTER_AUTH_URL=http://localhost:3200

# Long random string. Vercel Cron and cron-job.org send it as "Authorization: Bearer <secret>".
CRON_SECRET=
# Random string used to hash guest IP addresses on the song form.
IP_HASH_SALT=

# Web push — generate with: pnpm vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Telegram — create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; passed to Telegram when the webhook is registered.
TELEGRAM_WEBHOOK_SECRET=

# Optional — developer.spotify.com app. Turns on Spotify search in the song form
# (picks then carry a Spotify link) and adds artist/duration to Spotify links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — Google Cloud → YouTube Data API v3 → API key. Finds a YouTube link
# for each song added without one (about 100 songs a day on the free quota).
YOUTUBE_API_KEY=
